# API keys (Gemini is the primary generator, Groq is the fallback)
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Generation (src/generation/generator.py)
# GENERATION_PROVIDER=gemini        # set to groq to force the Groq path
# GEMINI_MODEL=gemini-2.5-flash-lite  # also used by Tree Index traversal (code default there: gemini-2.5-flash)
# GROQ_MODEL=llama-3.3-70b-versatile

# RAGAS scorer (src/evaluation/ragas_runner.py)
# RAGAS_GEMINI_MODEL=gemini-2.5-flash

# API server paths (src/api/main.py)
# CHUNKS_DIR=data/chunks
# INDEX_DIR=data/indexes
# EVAL_DB=results/evals.db

# Ingestion (scripts/ingest.py)
# DATA_DIR=data/
# CHUNK_SIZE=512     # tokens
# CHUNK_OVERLAP=64   # tokens
